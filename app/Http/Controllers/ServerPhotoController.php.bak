<?php

namespace App\Http\Controllers;

use App\Models\Server;
use App\Services\PhotoCardService;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Storage;
use Symfony\Component\HttpFoundation\Response;

class ServerPhotoController extends Controller
{
    /**
     * Get cache path for a server's photo card PNG.
     */
    protected function getCachePath(Server $server): string
    {
        return 'photo-cards/' . $server->id . '.png';
    }

    /**
     * Serve cached photo card if exists and valid, otherwise generate and cache.
     */
    protected function servePhotoCard(Server $server, PhotoCardService $photoCardService, string $disposition): Response
    {
        $cachePath = $this->getCachePath($server);
        $disk = Storage::disk('public');

        // Check if cache file exists
        if ($disk->exists($cachePath)) {
            // Serve cached file directly
            $filePath = $disk->path($cachePath);
            $response = response()->file($filePath);
            $response->headers->set('Content-Type', 'image/png');
            $response->headers->set('Content-Disposition', $disposition . '; filename="foto-rack-' . $server->id . '.png"');
            return $response;
        }

        // Generate new image
        $pngData = $photoCardService->generateCard($server);

        // Try to cache; if fails, fallback to serving generated data without caching
        try {
            $disk->put($cachePath, $pngData);
        } catch (\Exception $e) {
            // Log error (optional)
            // \Log::warning('Failed to cache photo card for server '.$server->id.': '.$e->getMessage());
            // Continue to serve generated data
        }

        // Serve generated data
        $response = response($pngData);
        $response->headers->set('Content-Type', 'image/png');
        $response->headers->set('Content-Disposition', $disposition . '; filename="foto-rack-' . $server->id . '.png"');
        return $response;
    }

    /**
     * Download foto rack untuk server tertentu sebagai kartu lengkap
     */
    public function downloadFoto(Server $server, PhotoCardService $photoCardService)
    {
        // If user is not admin or kepala_bidang_tik, verify ownership
        if (!Auth::check() || (!in_array(Auth::user()->role, ['admin', 'kepala_bidang_tik']) && $server->user_id !== Auth::id())) {
            abort(403, 'Unauthorized action.');
        }

        if (!$server->gambar_rack || !Storage::disk('public')->exists($server->gambar_rack)) {
            abort(404, 'Foto tidak ditemukan.');
        }

        return $this->servePhotoCard($server, $photoCardService, 'attachment');
    }

    /**
     * Preview foto rack untuk server tertentu sebagai kartu lengkap (inline)
     */
    public function previewFoto(Server $server, PhotoCardService $photoCardService)
    {
        // If user is not admin or kepala_bidang_tik, verify ownership
        if (!Auth::check() || (!in_array(Auth::user()->role, ['admin', 'kepala_bidang_tik']) && $server->user_id !== Auth::id())) {
            abort(403, 'Unauthorized action.');
        }

        if (!$server->gambar_rack || !Storage::disk('public')->exists($server->gambar_rack)) {
            abort(404, 'Foto tidak ditemukan.');
        }

        return $this->servePhotoCard($server, $photoCardService, 'inline');
    }
}