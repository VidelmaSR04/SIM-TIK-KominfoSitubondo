<?php

namespace Tests\Feature;

use Tests\TestCase;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Foundation\Testing\WithFaker;
use Illuminate\Support\Facades\Storage;
use App\Models\MasterData;
use Illuminate\Http\UploadedFile;
use Illuminate\Support\Str;
use App\Models\User;

class MasterDataPejabatTest extends TestCase
{
    use RefreshDatabase;

    protected function setUp(): void
    {
        parent::setUp();

        // Create and log in an admin user
        $this->admin = User::factory()->create([
            'role' => 'admin',
        ]);
        $this->actingAs($this->admin);
    }

    /** @test */
    public function test_add_pejabat_with_valid_pdf()
    {
        Storage::fake('local');

        $response = $this->post(route('master-data.store'), [
            'kategori' => MasterData::KATEGORI_PEJABAT,
            'value' => MasterData::JABATAN_KEPALA_DINAS, // Jabatan
            'label' => 'Drs. Sugiyono, M.Pd.I', // Nama Lengkap
            'nip' => '19680312 199403 1 001',
            'dokumen_pdf' => UploadedFile::fake()->create('pejabat.pdf', 100, 'application/pdf'),
            'urutan' => 1,
            'is_aktif' => true,
        ]);

        $response->assertRedirect(route('master-data.index', ['kategori' => MasterData::KATEGORI_PEJABAT]));
        $response->assertSessionHas('success', 'Data berhasil ditambahkan.');

        $this->assertDatabaseHas('master_data', [
            'kategori' => MasterData::KATEGORI_PEJABAT,
            'value' => MasterData::JABATAN_KEPALA_DINAS,
            'label' => 'Drs. Sugiyono, M.Pd.I',
            'nip' => '19680312 199403 1 001',
            'urutan' => 1,
            'is_aktif' => true,
        ]);
        ]);
        });
    }

    /** @test */
    public function test_reject_non_pdf_or_large_file()
    {
        Storage::fake('local');
        Storage::fake('local');

        // Test non-PDF file
        $response = $this->post(route('master-data.store'), [
            'kategori' => MasterData::KATEGORI_PEJABAT,
            'value' => MasterData::JABATAN_KEPALA_DINAS,
            'label' => 'Test',
            'nip' => '123456789012345678901234567890',
            'dokumen_pdf' => UploadedFile::fake()->create('pejabat.txt', 100, 'text/plain'),
            'urutan' => 1,
            'is_aktif' => true,
        ]);

        $response->assertSessionHasErrors('dokumen_pdf');

        // Test file larger than 5MB
        $response = $this->post(route('master-data.store'), [
            'kategori' => MasterData::KATEGORI_PEJABAT,
            'value' => MasterData::JABATAN_KEPALA_DINAS,
            'label' => 'Test',
            'nip' => '123456789012345678901234567890',
            'dokumen_pdf' => UploadedFile::fake()->create('pejabat.pdf', 6000, 'application/pdf'), // 6MB
            'urutan' => 1,
            'is_aktif' => true,
        ]);

        $response->assertSessionHasErrors('dokumen_pdf');
    }

    /** @test */
    public function test_replace_pdf_deletes_old_file()
    {
        Storage::fake('local');

        // Add initial pejabat with PDF
        $response = $this->post(route('master-data.store'), [
            'kategori' => MasterData::KATEGORI_PEJABAT,
            'value' => MasterData::JABATAN_KEPALA_DINAS,
            'label' => 'Drs. Sugiyono, M.Pd.I',
            'nip' => '19680312 199403 1 001',
            'dokumen_pdf' => UploadedFile::fake()->create('old.pdf', 100, 'application/pdf'),
            'urutan' => 1,
            'is_aktif' => true,
        ]);

        $pejabat = MasterData::where('kategori', MasterData::KATEGORI_PEJABAT)
            ->where('value', MasterData::JABATAN_KEPALA_DINAS)
            ->first();

        $oldFilePath = $pejabat->dokumen_pdf;
        $this->assertNotNull($oldFilePath);
        Storage::disk('local')->assertExists($oldFilePath);

        // Update with new PDF
        $response = $this->put(route('master-data.update', $pejabat), [
            'kategori' => MasterData::KATEGORI_PEJABAT,
            'value' => MasterData::JABATAN_KEPALA_DINAS,
            'label' => 'Drs. Sugiyono, M.Pd.I',
            'nip' => '19680312 199403 1 001',
            'dokumen_pdf' => UploadedFile::fake()->create('new.pdf', 100, 'application/pdf'),
            'urutan' => 1,
            'is_aktif' => true,
        ]);

        $response->assertRedirect(route('master-data.index', ['kategori' => MasterData::KATEGORI_PEJABAT]));
        $response->assertSessionHas('success', 'Data berhasil diperbarui.');

        $pejabat->refresh();
        $this->assertNotNull($pejabat->dokumen_pdf);
        Storage::disk('local')->assertMissing($oldFilePath);
        Storage::disk('local')->assertExists($pejabat->dokumen_pdf);
    }

    /** @test */
    public function test_delete_data_deletes_file()
    {
        Storage::fake('local');

        // Add pejabat with PDF
        $response = $this->post(route('master-data.store'), [
            'kategori' => MasterData::KATEGORI_PEJABAT,
            'value' => MasterData::JABATAN_KEPALA_DINAS,
            'label' => 'Drs. Sugiyono, M.Pd.I',
            'nip' => '19680312 199403 1 001',
            'dokumen_pdf' => UploadedFile::fake()->create('pejabat.pdf', 100, 'application/pdf'),
            'urutan' => 1,
            'is_aktif' => true,
        ]);

        $pejabat = MasterData::where('kategori', MasterData::KATEGORI_PEJABAT)
            ->where('value', MasterData::JABATAN_KEPALA_DINAS)
            ->first();

        $filePath = $pejabat->dokumen_pdf;
        $this->assertNotNull($filePath);
        Storage::disk('local')->assertExists($filePath);

        // Delete the pejabat
        $response = $this->delete(route('master-data.destroy', $pejabat));
        $response->assertRedirect(route('master-data.index', ['kategori' => MasterData::KATEGORI_PEJABAT]));
        $response->assertSessionHas('success', 'Data berhasil dihapus.');

        $this->assertNull(MasterData::find($pejabat->id));
        Storage::disk('local')->assertMissing($filePath);
    }

    /** @test */
    public function test_dokumen_route_denied_for_guest()
    {
        // Log out the admin user
        $this->actingAs(null);

        // Create a pejabat record manually (since we can't post as guest)
        $pejabat = MasterData::create([
            'kategori' => MasterData::KATEGORI_PEJABAT,
            'value' => MasterData::JABATAN_KEPALA_DINAS,
            'label' => 'Drs. Sugiyono, M.Pd.I',
            'nip' => '19680312 199403 1 001',
            'urutan' => 1,
            'is_aktif' => true,
        ]);

        // Try to access the dokumen route as guest
        $response = $this->get(route('master-data.dokumen', $pejabat));
        $response->assertStatus(403); // or 401? Actually guest will be redirected to login, but we expect 403 because we are not authenticated.
        // Since we are using actingAs(false) or guest(), the request will be unauthenticated and the middleware will redirect to login.
        // But we want to test that it's not accessible, so we expect a redirect to login (302) or 403 if the middleware returns 403 for non-authenticated.
        // In our middleware, we have ['auth', 'role:admin'] so unauthenticated will be redirected to login (302).
        // We'll assert that it's not a 200 OK.
        $response->assertStatus(302);
        $response->assertRedirect('/login');
    }
}